{
  "name": "dsh-power-meter",
  "version": "1.1.2",
  "private": true,
  "description": "Shows this Mac's cumulative wall energy, boot time and a selectable rolling-average power inside the DSH web GUI. Live watts come from SMC (PDTR/PSTR); cumulative energy from the firmware counters. 在 DSH 里显示整机累计耗电、开机时间与可调窗口的平均功率。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "native/smc.c",
    "native/smc-read"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
